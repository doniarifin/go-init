package main

import (
	"log"
	"net/http"
	"os"

	"github.com/joho/godotenv"
{{if .HasRoutes}}	"{{.ProjectName}}/{{.Pkg.Route}}"
{{else}}	"github.com/go-chi/chi/v5"
{{end}})

func main() {
	err := godotenv.Load()
	if err != nil {
		log.Println("No .env file found")
	}

{{if .HasRoutes}}	r := route.SetupRouter()
{{else}}	r := chi.NewRouter()
{{end}}
	r.Get("/", func(w http.ResponseWriter, rq *http.Request) {
		w.Write([]byte("Hello from {{.ProjectName}}"))
	})

	port := os.Getenv("APP_PORT")
	if port == "" {
		port = "3000"
	}

	log.Printf("Server running on :%s", port)
	log.Fatal(http.ListenAndServe(":"+port, r))
}
